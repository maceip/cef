# Pre-baked build environment for CEF native ARM64 (Graviton) builds.
# Runs on c7g instances for native aarch64 compilation (no cross-compile).
#
# Build on ARM host:
#   docker build -f Dockerfile.linux-arm -t cef-builder-linux-arm .

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -yq --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    jq \
    libglib2.0-dev \
    lsb-release \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    sudo \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

RUN curl -fsSL https://github.com/mozilla/sccache/releases/download/v0.9.1/sccache-v0.9.1-aarch64-unknown-linux-musl.tar.gz \
    | tar -xz -C /usr/local/bin --strip-components=1 --wildcards '*/sccache'

RUN git clone --depth=1 https://chromium.googlesource.com/chromium/tools/depot_tools.git /opt/depot_tools
ENV PATH="/opt/depot_tools:${PATH}"

ENV SCCACHE_BUCKET="cef-build-cache" \
    SCCACHE_REGION="us-east-1" \
    SCCACHE_S3_KEY_PREFIX="sccache/" \
    RUSTC_WRAPPER="sccache"

WORKDIR /build
